// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ATHLETE
  OBSERVER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Category {
  U5
  U6
  U7
  U8
  U9
  U10
  U11
  U12
  U13
  U14
  U15
  U16
  U17
  U18
  U19
  U20
  AMATEUR
  PROFESSIONAL
}

enum Position {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum DominantFoot {
  RIGHT
  LEFT
}

enum MatchResult {
  WIN
  LOSS
  DRAW
  NOT_FINISHED
}

enum MatchStatus {
  SCHEDULED    // Partida agendada para o futuro
  LIVE         // Partida em andamento
  FINISHED     // Partida finalizada
  CANCELLED    // Partida cancelada
}

enum Modality {
  FUT_11
  FUT_7
  FUTSAL
}

enum PlayerPosition {
  STARTER
  SUBSTITUTE
}

enum PlayType {
  GOAL
  DIFFICULT_SAVE
  EASY_SAVE
  ASSIST
  FOUL_COMMITTED
  FOUL_RECEIVED
  DRIBBLE
  ANTICIPATION
  LONG_PASS
  FREE_KICK
  YELLOW_CARD
  RED_CARD
  RIGHT_FOOT_SHOT
  LEFT_FOOT_SHOT
  HEADER
  TACKLE
  INTERCEPTION
  CROSS
  CORNER_KICK
  PENALTY
  PASS
  KEY_PASS
  
  // Específicos para Goleiro
  PENALTY_SAVE
  ONE_ON_ONE_SAVE
  REFLEX_SAVE
  DIVING_SAVE
  CATCH
  PUNCH
  DISTRIBUTION
  GOAL_KICK
  THROW_OUT
  
  // Específicos para Linha
  SHOT_BLOCKED
  CLEARANCE
  OFFENSIVE_FOUL
  DEFENSIVE_FOUL
  BALL_RECOVERY
  THROUGH_PASS
  BACKHEEL
  VOLLLEY
  BICYCLE_KICK
  
  // Situações Especiais
  OFFSIDE
  MISSED_SHOT
  SHOT_ON_TARGET
  SHOT_OFF_TARGET
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(ATHLETE)
  isActive  Boolean  @default(false)
  isProfile Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athleteProfile AthleteProfile?
  refreshTokens  RefreshToken[]
  tokenBlacklist TokenBlacklist[]
  verificationCodes VerificationCode[]
  favorites      Favorite[]
  teams          Team[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model TokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique  // O JWT token completo
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // Quando o token expira naturalmente
  createdAt DateTime @default(now())

  @@map("token_blacklist")
}

model VerificationCode {
  id        String   @id @default(uuid())
  code      String   // Código de 6 dígitos
  email     String   
  userId    String?  // Opcional, caso o usuário ainda não esteja criado
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "EMAIL_VERIFICATION", "PASSWORD_RESET", etc.
  expiresAt DateTime // Código expira em 15 minutos
  usedAt    DateTime? // Quando foi usado
  createdAt DateTime @default(now())

  @@map("verification_codes")
}

model AthleteProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cpf            String        @unique
  gender         Gender
  nickname       String?        @unique
  profilePhoto   String?
  birthDate      DateTime

  instagramUrl   String?
  twitterUrl     String?
  
  height         Float         
  weight         Float 
  dominantFoot   DominantFoot

  primaryPosition   Position
  secondaryPosition Position?
  currentClub       String?
  biography         String?
  
  hasManager        Boolean     @default(false)
  managerName       String?
  managerCompany    String?
  managerContact    String?
  
  address           Address?
  teams             AthleteTeam[]
  teamHistory       TeamHistory[]
  favorites         Favorite[]
  matches           Match[]
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("athlete_profiles")
}

model Address {
  id          String         @id @default(uuid())
  athleteId   String         @unique
  athlete     AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  
  zipCode     String        
  street      String        
  number      String        
  complement  String?       
  district    String        
  city        String        
  state       String         
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("addresses")
}

model TeamHistory {
  id          String         @id @default(uuid())
  athleteId   String
  athlete     AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  
  teamId      String
  team        Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  startDate   DateTime
  endDate     DateTime?      // null se ainda joga no time
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("team_history")
}

model Team {
  id          String         @id @default(uuid())
  name        String
  nickname    String?        // Nome popular/apelido (ex: "Palmeiras")
  acronym     String         
  shieldPhoto String?        
  
  // Relacionamento com o atleta que criou o time
  userId      String         
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relacionamentos
  athletes    AthleteTeam[]
  teamHistory TeamHistory[]
  matches     Match[]        // Partidas onde esse time jogou
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("teams")
}

model AthleteTeam {
  id        String         @id @default(uuid())
  athleteId String
  teamId    String
  
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([athleteId, teamId])
  @@map("athlete_teams")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  athleteId String
  
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, athleteId])
  @@map("favorites")
}

model Match {
  id              String         @id @default(uuid())
  athleteId       String
  athlete         AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  
  myTeamId        String
  myTeam          Team           @relation(fields: [myTeamId], references: [id])
  adversaryTeam   String         
  date            DateTime
  modality        Modality
  category        Category
  location        String
  streamUrl       String?
  
  status          MatchStatus    @default(SCHEDULED)
  result          MatchResult    @default(NOT_FINISHED)
  myTeamScore     Int?
  adversaryScore  Int?
  
  playerPosition  PlayerPosition
  observations    String?
  
  approximateTime Int?           // tempo em minutos em campo
  photoUrl        String?
  videoUrl        String?
  performanceRating Int?         // nota de 1 a 5
  
  plays           Play[]
  scout           Scout?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("matches")
}

model Play {
  id              String   @id @default(uuid())
  matchId         String
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  playType        PlayType
  videoUrl        String?
  photoUrl        String?
  rating          Int?     // nota de 1 a 5
  approximateTime Int?     // tempo aproximado do lance (em minutos)
  observations    String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("plays")
}

model Scout {
  id                    String         @id @default(uuid())
  matchId               String         @unique
  match                 Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  // Estatísticas gerais
  totalPlays            Int            @default(0)
  positiveActions       Int            @default(0)
  negativeActions       Int            @default(0)
  neutralActions        Int            @default(0)
  
  // Estatísticas por categoria
  goals                 Int            @default(0)
  assists               Int            @default(0)
  saves                 Int            @default(0)
  defensiveActions      Int            @default(0)
  tackles               Int            @default(0)
  interceptions         Int            @default(0)
  crosses               Int            @default(0)
  dribbles              Int            @default(0)
  fouls                 Int            @default(0)
  yellowCards           Int            @default(0)
  redCards              Int            @default(0)
  
  // Avaliação geral
  overallRating         Float?         // média das notas dos plays
  performanceNote       String?        // observações gerais
  
  // Pontos fortes e fracos identificados
  strengths             String?        // JSON array de strings
  weaknesses            String?        // JSON array de strings
  
  // Metadados
  generatedAt           DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@map("scouts")
}