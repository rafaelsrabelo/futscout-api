// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ATHLETE
  OBSERVER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Category {
  U5
  U6
  U7
  U8
  U9
  U10
  U11
  U12
  U13
  U14
  U15
  U16
  U17
  U18
  U19
  U20
  AMATEUR
  PROFESSIONAL
}

enum Position {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum DominantFoot {
  RIGHT
  LEFT
}

// Classificação interna do atleta (admin-only).
// null = ainda não classificado. Novos valores podem ser adicionados no futuro.
enum AthleteClassification {
  DESENVOLVIMENTO
  PERFORMANCE
}

enum MatchResult {
  WIN
  LOSS
  DRAW
  NOT_FINISHED
}

enum MatchStatus {
  SCHEDULED // Partida agendada para o futuro
  LIVE // Partida em andamento
  FINISHED // Partida finalizada
  CANCELLED // Partida cancelada
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  APPLE
}

enum Modality {
  FUT_11
  FUT_7
  FUTSAL
}

enum PlayerPosition {
  STARTER
  SUBSTITUTE
}

enum PlayType {
  GOAL
  DIFFICULT_SAVE
  EASY_SAVE
  ASSIST
  FOUL_COMMITTED
  FOUL_RECEIVED
  DRIBBLE
  ANTICIPATION
  LONG_PASS
  FREE_KICK
  YELLOW_CARD
  RED_CARD
  RIGHT_FOOT_SHOT
  LEFT_FOOT_SHOT
  HEADER
  TACKLE
  INTERCEPTION
  CROSS
  CORNER_KICK
  PENALTY
  PASS
  KEY_PASS

  // Específicos para Goleiro
  PENALTY_SAVE
  ONE_ON_ONE_SAVE
  REFLEX_SAVE
  DIVING_SAVE
  CATCH
  PUNCH
  DISTRIBUTION
  GOAL_KICK
  THROW_OUT

  // Específicos para Linha
  SHOT_BLOCKED
  CLEARANCE
  OFFENSIVE_FOUL
  DEFENSIVE_FOUL
  BALL_RECOVERY
  THROUGH_PASS
  BACKHEEL
  VOLLLEY
  BICYCLE_KICK

  // Situações Especiais
  OFFSIDE
  MISSED_SHOT
  SHOT_ON_TARGET
  SHOT_OFF_TARGET

  // Compilações
  BEST_MOMENTS // Melhores momentos
}

enum PlayClassification {
  PHYSICAL // Physical aspects: speed, strength, endurance
  TACTICAL // Tactical aspects: positioning, marking, coverage
  MENTAL // Mental aspects: concentration, decision making, pressure
  TECHNICAL // Technical aspects: ball control, passing, finishing
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  cpf              String?      @unique
  name             String
  password         String
  role             UserRole? // Opcional - será definido após login social
  provider         AuthProvider @default(CREDENTIALS)
  providerId       String?
  emailVerified    Boolean      @default(false)
  isActive         Boolean      @default(false)
  isProfile        Boolean      @default(false)
  isImported       Boolean      @default(false) // Cadastro importado via script — register pode reativar
  stripeCustomerId String?
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  athleteProfile             AthleteProfile?
  observerProfile            ObserverProfile?
  refreshTokens              RefreshToken[]
  tokenBlacklist             TokenBlacklist[]
  verificationCodes          VerificationCode[]
  favorites                  Favorite[]
  teams                      Team[]
  savedSearches              SavedSearch[]
  subscriptions              Subscription[]
  usages                     Usage[]
  // Classificações que esse usuário (admin) registrou em atletas
  athleteClassificationsMade AthleteClassificationLog[] @relation("ClassifiedBy")
  pushTokens                 PushToken[]
  // Notificações que esse usuário (admin) disparou
  notificationsSent          NotificationLog[]          @relation("NotificationsSentBy")
  scoutThreads               ScoutThread[]
  notifications              UserNotification[]

  @@unique([provider, providerId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model TokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique // O JWT token completo
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // Quando o token expira naturalmente
  createdAt DateTime @default(now())

  @@map("token_blacklist")
}

model VerificationCode {
  id        String    @id @default(uuid())
  code      String // Código de 6 dígitos
  email     String
  userId    String? // Opcional, caso o usuário ainda não esteja criado
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "EMAIL_VERIFICATION", "PASSWORD_RESET", etc.
  expiresAt DateTime // Código expira em 15 minutos
  usedAt    DateTime? // Quando foi usado
  createdAt DateTime  @default(now())

  @@map("verification_codes")
}

model AthleteProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gender       Gender?
  nickname     String?   @unique
  profilePhoto String?
  birthDate    DateTime?

  instagramUrl String?
  twitterUrl   String?
  youtubeUrl   String?

  height       Float?
  weight       Float?
  dominantFoot DominantFoot?

  primaryPosition   Position?
  secondaryPosition Position?
  currentClub       String?
  biography         String?

  hasManager     Boolean @default(false) // Possui empresário ou responsável
  managerName    String? // Nome do empresário ou responsável
  managerCompany String? // Empresa do empresário ou responsável
  managerContact String? // Contato do empresário ou responsável

  // Acompanhamentos profissionais
  hasNutritionist    Boolean @default(false) // Acompanhamento nutricional
  hasPsychologist    Boolean @default(false) // Acompanhamento psicológico
  hasPersonalTrainer Boolean @default(false) // Treino personalizado com professor de educação física

  // Classificação interna (admin define). Snapshot da última entrada do log
  // para filtros rápidos. Histórico completo em AthleteClassificationLog.
  classification     AthleteClassification?
  classificationLogs AthleteClassificationLog[]

  address      Address?
  teams        AthleteTeam[]
  teamHistory  TeamHistory[]
  favorites    Favorite[]
  matches      Match[]
  plays        Play[] // Lances sem partida
  competitions Competition[] // Competições criadas pelo atleta
  achievements Achievement[] // Títulos e conquistas do atleta

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Notificações geradas pela atividade deste atleta
  notificationsGenerated UserNotification[]


  @@map("athlete_profiles")
}

// Histórico de classificações do atleta. Cada chamada ao endpoint admin de
// classificar gera uma linha aqui — o campo `classification` em
// AthleteProfile é o snapshot do último registro, mantido para filtros
// rápidos. classification null nesse log = admin removeu a classificação.
model AthleteClassificationLog {
  id             String                 @id @default(uuid())
  athleteId      String
  athlete        AthleteProfile         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  classification AthleteClassification?
  comment        String?
  classifiedById String
  classifiedBy   User                   @relation("ClassifiedBy", fields: [classifiedById], references: [id])
  createdAt      DateTime               @default(now())

  @@index([athleteId, createdAt(sort: Desc)])
  @@map("athlete_classification_logs")
}

model ObserverProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // O nome do observador vive apenas em `users.name` — definido no cadastro.
  currentClub  String? // Clube atual é opcional
  phone        String // Telefone de contato
  profilePhoto String? // Foto de perfil

  // Avisar quando um atleta favoritado cadastra partida ou publica lance.
  notifyOnFavoriteActivity Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("observer_profiles")
}

model Address {
  id        String         @id @default(uuid())
  athleteId String         @unique
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  zipCode    String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  country    String  @default("Brasil")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

model TeamHistory {
  id        String         @id @default(uuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime? // null se ainda joga no time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_history")
}

model Team {
  id          String  @id @default(uuid())
  name        String
  nickname    String? // Nome popular/apelido (ex: "Palmeiras") - DEPRECATED: não usar mais
  acronym     String? // Sigla do time (opcional)
  shieldPhoto String?
  isPrincipal Boolean @default(false) // Indica se é o time principal do usuário

  // Relacionamento com o atleta que criou o time
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relacionamentos
  athletes    AthleteTeam[]
  teamHistory TeamHistory[]
  matches     Match[] // Partidas onde esse time jogou

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teams")
}

model Competition {
  id          String    @id @default(uuid())
  name        String // Nome da competição (ex: "Campeonato Cearense 2024")
  description String? // Descrição opcional
  startDate   DateTime? // Data de início
  endDate     DateTime? // Data de término
  location    String? // Local da competição
  modality    Modality? // Modalidade da competição
  category    Category? // Categoria da competição

  // Relacionamento com o atleta que criou a competição
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  // Relacionamentos
  matches Match[] // Partidas da competição

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("competitions")
}

model AthleteTeam {
  id        String @id @default(uuid())
  athleteId String
  teamId    String

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  team    Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([athleteId, teamId])
  @@map("athlete_teams")
}

model Favorite {
  id        String @id @default(uuid())
  userId    String
  athleteId String

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, athleteId])
  @@map("favorites")
}

model Match {
  id        String         @id @default(uuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  myTeamId      String
  myTeam        Team     @relation(fields: [myTeamId], references: [id])
  adversaryTeam String
  date          DateTime
  modality      Modality
  category      Category
  location      String
  streamUrl     String?

  // Relacionamento com competição (opcional - se null, é amistoso)
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  status         MatchStatus @default(SCHEDULED)
  result         MatchResult @default(NOT_FINISHED)
  myTeamScore    Int?
  adversaryScore Int?

  playerPosition PlayerPosition? // Titular ou reserva (pode ser definido ao finalizar)
  observations   String?

  matchDuration     Int? // duração total da partida em minutos
  approximateTime   Int? // tempo em minutos que o atleta jogou
  photoUrl          String?
  videoUrl          String?
  youtubeUrl        String? // link do YouTube da partida
  performanceRating Int? // nota de 1 a 5

  plays Play[]
  scout Scout?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("matches")
}

model Play {
  id      String  @id @default(uuid())
  matchId String?
  match   Match?  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Relacionamento com atleta (para lances sem partida)
  athleteId String?
  athlete   AthleteProfile? @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  playType     PlayType
  videoUrl     String?
  thumbnailUrl String? // Thumbnail gerado automaticamente do vídeo
  photoUrl     String?
  rating       Int? // nota de 1 a 5
  observations String?

  // Relacionamento com classificações
  classifications PlayClassifications[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId, videoUrl])
  @@index([matchId])
  @@index([videoUrl])
  @@index([createdAt])
  @@map("plays")
}

model PlayClassifications {
  id             String             @id @default(uuid())
  playId         String
  classification PlayClassification

  play Play @relation(fields: [playId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([playId, classification]) // Evita classificação duplicada no mesmo play
  @@map("play_classifications")
}

model Scout {
  id      String @id @default(uuid())
  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Estatísticas gerais
  totalPlays      Int @default(0)
  positiveActions Int @default(0)
  negativeActions Int @default(0)
  neutralActions  Int @default(0)

  // Estatísticas por categoria
  goals            Int @default(0)
  assists          Int @default(0)
  saves            Int @default(0)
  defensiveActions Int @default(0)
  tackles          Int @default(0)
  interceptions    Int @default(0)
  crosses          Int @default(0)
  dribbles         Int @default(0)
  fouls            Int @default(0)
  yellowCards      Int @default(0)
  redCards         Int @default(0)

  // Avaliação geral
  overallRating   Float? // média das notas dos plays
  performanceNote String? // observações gerais

  // Pontos fortes e fracos identificados
  strengths  String? // JSON array de strings
  weaknesses String? // JSON array de strings

  // Metadados
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("scouts")
}

model SavedSearch {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String // "Zagueiros Canhotos Sub-15"
  description String? // Descrição opcional do filtro

  // Filtros salvos (JSON com os critérios)
  filters Json // { "primaryPosition": "DEFENDER", "dominantFoot": "LEFT", "category": "U15", ... }

  // Metadados
  isActive Boolean @default(true) // Permite desativar sem deletar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("saved_searches")
}

model Plan {
  id                           String   @id @default(uuid())
  name                         String   @unique
  price                        Int // in cents
  currency                     String   @default("BRL")
  monthlyLimitMatches          Int?
  monthlyLimitVideos           Int? // Vídeos dentro de jogos (não limitado no FREE, só conta)
  monthlyLimitStandaloneVideos Int? // Vídeos standalone (lances sem partida)
  monthlyLimitAiMessages       Int? // Mensagens no chat de busca (IAFutscore). null = sem limite
  isUnlimited                  Boolean  @default(false)
  stripePriceId                String?
  createdAt                    DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan     @relation(fields: [planId], references: [id])
  status               String // active, canceled, past_due
  currentPeriodEnd     DateTime
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())

  @@map("subscriptions")
}

model Usage {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month                Int
  year                 Int
  videosUsed           Int      @default(0) // Vídeos dentro de jogos (só conta, não limita)
  standaloneVideosUsed Int      @default(0) // Vídeos standalone (lances sem partida)
  matchesUsed          Int      @default(0)
  aiMessagesUsed       Int      @default(0) // Mensagens enviadas ao chat de busca
  createdAt            DateTime @default(now())

  @@unique([userId, month, year])
  @@map("usages")
}

model Achievement {
  id        String         @id @default(uuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  name     String // Nome do título (ex: "Campeonato Estadual", "Melhor Jogador")
  category String // Categoria (ex: "U19", "Sub-17", "Profissional")
  year     Int // Ano da conquista
  type     AchievementType // COLECTIVE ou INDIVIDUAL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("achievements")
}

enum AchievementType {
  COLLECTIVE // Título coletivo (ex: campeonato com time)
  INDIVIDUAL // Título individual (ex: melhor jogador, artilheiro)
}

enum PushPlatform {
  IOS
  ANDROID
}

enum NotificationAudienceType {
  ALL
  USER_IDS
  ATHLETE_FILTER
}

model PushToken {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String       @unique // ExponentPushToken[...]
  platform   PushPlatform
  deviceName String?
  deviceId   String? // expo-constants installationId
  appVersion String?
  lastUsedAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
  @@index([deviceId])
  @@map("push_tokens")
}

model NotificationLog {
  id               String                   @id @default(uuid())
  title            String
  body             String
  data             Json? // payload customizado (ex.: { screen, params } para deep link)
  audienceType     NotificationAudienceType
  audiencePayload  Json // { userIds? , filters? }
  sentByUserId     String
  sentBy           User                     @relation("NotificationsSentBy", fields: [sentByUserId], references: [id], onDelete: Restrict)
  totalRecipients  Int                      @default(0) // usuários alvo (resolvidos da audiência)
  totalWithToken   Int                      @default(0) // destes, quantos tinham ≥1 PushToken
  successCount     Int                      @default(0) // tickets ok retornados pela Expo
  failureCount     Int                      @default(0) // tickets com erro
  invalidTokensCnt Int                      @default(0) // tokens removidos por DeviceNotRegistered
  createdAt        DateTime                 @default(now())

  @@index([createdAt])
  @@index([sentByUserId])
  @@map("notification_logs")
}

model ImportLog {
  id         String   @id @default(uuid())
  total      Int
  created    Int
  updated    Int
  errorCount Int
  errors     Json // array de { row, nome, cpf, error }
  createdAt  DateTime @default(now())

  @@map("import_logs")
}

// ============================================================
// ====== Chat de busca de atletas (IAFutscore) ======
// ============================================================
// Substitui o formulário de filtros do observador: em vez de preencher campos,
// ele conversa e a IA traduz a conversa em AthleteFilters via tool calling.

enum ScoutThreadStatus {
  OPEN
  CLOSED
}

enum ScoutMessageRole {
  USER
  ASSISTANT
  TOOL
}

model ScoutThread {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Título curto derivado da primeira mensagem, para listar as conversas.
  title  String?
  status ScoutThreadStatus @default(OPEN)

  messages ScoutMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("scout_threads")
}

model ScoutMessage {
  id       String      @id @default(uuid())
  threadId String
  thread   ScoutThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  role    ScoutMessageRole
  content String

  // Payload da tool quando role=TOOL: { name, arguments, summary }.
  toolCall Json?
  // Snapshot dos atletas devolvidos no turno, para a conversa re-renderizar
  // os cards ao ser reaberta sem precisar refazer a busca.
  cards    Json?

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("scout_messages")
}

// ============================================================
// ====== Notificações do usuário (caixa de entrada) ======
// ============================================================
// Diferente de NotificationLog, que é o registro de uma campanha do admin.
// Aqui é o que CADA usuário recebeu — hoje, atividade dos atletas que ele
// favoritou. Push sozinho é efêmero: se o observador não vê na hora, some.

enum UserNotificationType {
  FAVORITE_MATCH
  FAVORITE_PLAY
}

model UserNotification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  UserNotificationType
  title String
  body  String
  // Deep link para o app: { screen, params }.
  data  Json?

  // Atleta que gerou o evento. Cascade porque a notificação perde o sentido
  // se o perfil deixa de existir.
  actorAthleteId String?
  actorAthlete   AthleteProfile? @relation(fields: [actorAthleteId], references: [id], onDelete: Cascade)

  // Chave de agregação (userId:type:atleta). Um atleta que sobe 8 lances
  // gera UMA notificação com eventCount=8, não 8 pushes.
  groupKey   String
  eventCount Int    @default(1)

  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, readAt, createdAt])
  @@index([groupKey, readAt])
  @@map("user_notifications")
}
